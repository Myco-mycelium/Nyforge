<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>Nyforge.Shell</RootNamespace>
    <AssemblyName>Nyforge</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.1.3" />
    <!-- Condition below is a standard Avalonia template pattern for debug tooling -->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.1.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nyforge.Core\Nyforge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      NOTE: no explicit <AvaloniaResource Include="**\*.axaml" /> here — the
      Avalonia SDK auto-includes every .axaml via its default AvaloniaXaml
      glob. Listing them again as AvaloniaResource made App.axaml's
      x:Class get compiled twice (AVLN2002 Duplicate x:Class directive).
    -->
  </ItemGroup>

  <ItemGroup>
    <!--
      Bundled default Home screen (see docs/how-to/redesigning-the-home-screen.md).
      Copied to the output directory so AppContext.BaseDirectory/examples/...
      resolves at runtime even before anyone sets a custom Home screen path.
    -->
    <None Include="..\..\examples\forge-home\forge-home.nstudio">
      <Link>examples\forge-home\forge-home.nstudio</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
