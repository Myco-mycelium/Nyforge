<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Nyforge.Shell.Views.SettingsWindow"
        Title="Nyforge Preferences"
        Width="680" Height="520"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Nyforge.Brush.Background}">

  <Grid RowDefinitions="*,Auto">

    <!-- Main content area with sidebar -->
    <Grid Grid.Row="0" ColumnDefinitions="180,*">

      <!-- Sidebar navigation (Apple System Preferences style) -->
      <Border Grid.Column="0" Background="{DynamicResource Nyforge.Brush.Surface}"
              BorderBrush="{DynamicResource Nyforge.Brush.Separator}" BorderThickness="0,0,1,0">
        <StackPanel Margin="8,16,8,8" Spacing="2">
          <TextBlock Text="Preferences" FontSize="{DynamicResource Nyforge.Type.Headline}"
                     FontWeight="Bold" Foreground="{DynamicResource Nyforge.Brush.TextPrimary}"
                     Margin="8,0,0,16" />

          <Border Classes="palette-item selected" Tag="Appearance"
                  Padding="10,8" Cursor="Hand">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="🎨" FontSize="16" VerticalAlignment="Center" />
              <TextBlock Text="Appearance" FontSize="{DynamicResource Nyforge.Type.Body}"
                         Foreground="{DynamicResource Nyforge.Brush.TextPrimary}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>

          <Border Classes="palette-item" Tag="Editor"
                  Padding="10,8" Cursor="Hand">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="✏️" FontSize="16" VerticalAlignment="Center" />
              <TextBlock Text="Editor" FontSize="{DynamicResource Nyforge.Type.Body}"
                         Foreground="{DynamicResource Nyforge.Brush.TextPrimary}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>

          <Border Classes="palette-item" Tag="Canvas"
                  Padding="10,8" Cursor="Hand">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="🖼️" FontSize="16" VerticalAlignment="Center" />
              <TextBlock Text="Canvas" FontSize="{DynamicResource Nyforge.Type.Body}"
                         Foreground="{DynamicResource Nyforge.Brush.TextPrimary}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>

          <Border Classes="palette-item" Tag="Export"
                  Padding="10,8" Cursor="Hand">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="📦" FontSize="16" VerticalAlignment="Center" />
              <TextBlock Text="Export" FontSize="{DynamicResource Nyforge.Type.Body}"
                         Foreground="{DynamicResource Nyforge.Brush.TextPrimary}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>

          <Border Classes="palette-item" Tag="Keyboard"
                  Padding="10,8" Cursor="Hand">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="⌨️" FontSize="16" VerticalAlignment="Center" />
              <TextBlock Text="Keyboard" FontSize="{DynamicResource Nyforge.Type.Body}"
                         Foreground="{DynamicResource Nyforge.Brush.TextPrimary}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- Content panels (scrollable) -->
      <ScrollViewer Grid.Column="1" Padding="24,20">
        <StackPanel Spacing="24">

          <!-- APPEARANCE SECTION -->
          <StackPanel Spacing="12">
            <TextBlock Text="Appearance" FontSize="{DynamicResource Nyforge.Type.Title}"
                       FontWeight="SemiBold" Foreground="{DynamicResource Nyforge.Brush.TextPrimary}" />

            <TextBlock Text="Choose the visual theme for Nyforge." FontSize="{DynamicResource Nyforge.Type.Body}"
                       Foreground="{DynamicResource Nyforge.Brush.TextSecondary}" TextWrapping="Wrap" />

            <Border Classes="separator" />

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,8,0,0">
              <!-- Eclipse theme card -->
              <Border Grid.Column="0" Grid.Row="0" Background="{DynamicResource Nyforge.Brush.SurfaceElevated}"
                      CornerRadius="{DynamicResource Nyforge.Radius.Medium}" Padding="16"
                      BorderBrush="{DynamicResource Nyforge.Brush.Accent}" BorderThickness="2"
                      Margin="0,0,8,8" Cursor="Hand">
                <StackPanel Spacing="8">
                  <TextBlock Text="Eclipse" FontWeight="SemiBold" FontSize="{DynamicResource Nyforge.Type.Subhead}"
                             Foreground="{DynamicResource Nyforge.Brush.TextPrimary}" />
                  <TextBlock Text="Dark theme — immersive, focused" FontSize="{DynamicResource Nyforge.Type.Caption}"
                             Foreground="{DynamicResource Nyforge.Brush.TextSecondary}" />
                  <Border Background="#1C1C1E" CornerRadius="6" Height="48" />
                </StackPanel>
              </Border>

              <!-- Solar theme card -->
              <Border Grid.Column="1" Grid.Row="0" Background="{DynamicResource Nyforge.Brush.SurfaceElevated}"
                      CornerRadius="{DynamicResource Nyforge.Radius.Medium}" Padding="16"
                      BorderBrush="{DynamicResource Nyforge.Brush.Separator}" BorderThickness="2"
                      Margin="8,0,0,8" Cursor="Hand">
                <StackPanel Spacing="8">
                  <TextBlock Text="Solar" FontWeight="SemiBold" FontSize="{DynamicResource Nyforge.Type.Subhead}"
                             Foreground="{DynamicResource Nyforge.Brush.TextPrimary}" />
                  <TextBlock Text="Light theme — bright, warm" FontSize="{DynamicResource Nyforge.Type.Caption}"
                             Foreground="{DynamicResource Nyforge.Brush.TextSecondary}" />
                  <Border Background="#F2F2F7" CornerRadius="6" Height="48" />
                </StackPanel>
              </Border>

              <!-- Canvas size -->
              <StackPanel Grid.Column="0" Grid.Row="1" Spacing="4" Margin="0,4,8,0">
                <TextBlock Text="Default Canvas Size" FontSize="{DynamicResource Nyforge.Type.Body}"
                           Foreground="{DynamicResource Nyforge.Brush.TextPrimary}" />
                <Grid ColumnDefinitions="*,Auto,*">
                  <NumericUpDown Grid.Column="0" Value="1024" Minimum="320" Maximum="7680"
                                 Margin="0,0,4,0" />
                  <TextBlock Grid.Column="1" Text="×" VerticalAlignment="Center"
                             FontSize="{DynamicResource Nyforge.Type.Body}"
                             Foreground="{DynamicResource Nyforge.Brush.TextSecondary}" Margin="4,0" />
                  <NumericUpDown Grid.Column="2" Value="768" Minimum="240" Maximum="4320"
                                 Margin="4,0,0,0" />
                </Grid>
              </StackPanel>

              <!-- Auto-save -->
              <StackPanel Grid.Column="1" Grid.Row="1" Spacing="4" Margin="8,4,0,0">
                <TextBlock Text="Auto-save" FontSize="{DynamicResource Nyforge.Type.Body}"
                           Foreground="{DynamicResource Nyforge.Brush.TextPrimary}" />
                <CheckBox Content="Enable auto-save" IsChecked="True"
                          FontSize="{DynamicResource Nyforge.Type.Body}" />
              </StackPanel>
            </Grid>
          </StackPanel>

          <Border Classes="separator" Margin="0,8" />

          <!-- EDITOR SECTION -->
          <StackPanel Spacing="12">
            <TextBlock Text="Editor" FontSize="{DynamicResource Nyforge.Type.Title}"
                       FontWeight="SemiBold" Foreground="{DynamicResource Nyforge.Brush.TextPrimary}" />

            <TextBlock Text="Configure the design canvas and editing behavior." FontSize="{DynamicResource Nyforge.Type.Body}"
                       Foreground="{DynamicResource Nyforge.Brush.TextSecondary}" TextWrapping="Wrap" />

            <Border Classes="separator" />

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" Margin="0,8,0,0">
              <StackPanel Grid.Column="0" Grid.Row="0" Spacing="4">
                <TextBlock Text="Snap to Grid" FontSize="{DynamicResource Nyforge.Type.Body}"
                           Foreground="{DynamicResource Nyforge.Brush.TextPrimary}" />
                <CheckBox Content="Enable snap-to-grid" IsChecked="True"
                          FontSize="{DynamicResource Nyforge.Type.Body}" />
              </StackPanel>

              <StackPanel Grid.Column="1" Grid.Row="0" Spacing="4">
                <TextBlock Text="Grid Size" FontSize="{DynamicResource Nyforge.Type.Body}"
                           Foreground="{DynamicResource Nyforge.Brush.TextPrimary}" />
                <NumericUpDown Value="8" Minimum="4" Maximum="32" />
              </StackPanel>

              <StackPanel Grid.Column="0" Grid.Row="1" Spacing="4">
                <TextBlock Text="Alignment Guides" FontSize="{DynamicResource Nyforge.Type.Body}"
                           Foreground="{DynamicResource Nyforge.Brush.TextPrimary}" />
                <CheckBox Content="Show alignment guides" IsChecked="True"
                          FontSize="{DynamicResource Nyforge.Type.Body}" />
              </StackPanel>

              <StackPanel Grid.Column="1" Grid.Row="1" Spacing="4">
                <TextBlock Text="Smart Guides" FontSize="{DynamicResource Nyforge.Type.Body}"
                           Foreground="{DynamicResource Nyforge.Brush.TextPrimary}" />
                <CheckBox Content="Show smart guides" IsChecked="True"
                          FontSize="{DynamicResource Nyforge.Type.Body}" />
              </StackPanel>

              <StackPanel Grid.Column="0" Grid.Row="2" Spacing="4">
                <TextBlock Text="Nudge Amount" FontSize="{DynamicResource Nyforge.Type.Body}"
                           Foreground="{DynamicResource Nyforge.Brush.TextPrimary}" />
                <Grid ColumnDefinitions="*,Auto">
                  <NumericUpDown Value="4" Minimum="1" Maximum="20" />
                  <TextBlock Grid.Column="1" Text="px" VerticalAlignment="Center" Margin="6,0,0,0"
                             FontSize="{DynamicResource Nyforge.Type.Body}"
                             Foreground="{DynamicResource Nyforge.Brush.TextSecondary}" />
                </Grid>
              </StackPanel>

              <StackPanel Grid.Column="1" Grid.Row="2" Spacing="4">
                <TextBlock Text="Shift Multiplier" FontSize="{DynamicResource Nyforge.Type.Body}"
                           Foreground="{DynamicResource Nyforge.Brush.TextPrimary}" />
                <Grid ColumnDefinitions="*,Auto">
                  <NumericUpDown Value="5" Minimum="2" Maximum="20" />
                  <TextBlock Grid.Column="1" Text="×" VerticalAlignment="Center" Margin="6,0,0,0"
                             FontSize="{DynamicResource Nyforge.Type.Body}"
                             Foreground="{DynamicResource Nyforge.Brush.TextSecondary}" />
                </Grid>
              </StackPanel>
            </Grid>

            <CheckBox Content="Show component type labels on canvas" IsChecked="True"
                      FontSize="{DynamicResource Nyforge.Type.Body}" />
            <CheckBox Content="Show component IDs in Layers panel" IsChecked="True"
                      FontSize="{DynamicResource Nyforge.Type.Body}" />
            <CheckBox Content="Enable multi-select (Ctrl+Click)" IsChecked="True"
                      FontSize="{DynamicResource Nyforge.Type.Body}" />
          </StackPanel>

          <Border Classes="separator" Margin="0,8" />

          <!-- CANVAS SECTION -->
          <StackPanel Spacing="12">
            <TextBlock Text="Canvas" FontSize="{DynamicResource Nyforge.Type.Title}"
                       FontWeight="SemiBold" Foreground="{DynamicResource Nyforge.Brush.TextPrimary}" />

            <TextBlock Text="Configure the design canvas appearance and behavior." FontSize="{DynamicResource Nyforge.Type.Body}"
                       Foreground="{DynamicResource Nyforge.Brush.TextSecondary}" TextWrapping="Wrap" />

            <Border Classes="separator" />

            <StackPanel Spacing="8" Margin="0,8,0,0">
              <CheckBox Content="Show grid overlay" IsChecked="False"
                        FontSize="{DynamicResource Nyforge.Type.Body}" />
              <CheckBox Content="Show rulers" IsChecked="False"
                        FontSize="{DynamicResource Nyforge.Type.Body}" />
              <CheckBox Content="Show component bounds" IsChecked="True"
                        FontSize="{DynamicResource Nyforge.Type.Body}" />
              <CheckBox Content="Show selection handles" IsChecked="True"
                        FontSize="{DynamicResource Nyforge.Type.Body}" />
              <CheckBox Content="Zoom to fit on selection" IsChecked="False"
                        FontSize="{DynamicResource Nyforge.Type.Body}" />
            </StackPanel>
          </StackPanel>

          <Border Classes="separator" Margin="0,8" />

          <!-- EXPORT SECTION -->
          <StackPanel Spacing="12">
            <TextBlock Text="Export" FontSize="{DynamicResource Nyforge.Type.Title}"
                       FontWeight="SemiBold" Foreground="{DynamicResource Nyforge.Brush.TextPrimary}" />

            <TextBlock Text="Configure code generation and export targets." FontSize="{DynamicResource Nyforge.Type.Body}"
                       Foreground="{DynamicResource Nyforge.Brush.TextSecondary}" TextWrapping="Wrap" />

            <Border Classes="separator" />

            <StackPanel Spacing="8" Margin="0,8,0,0">
              <TextBlock Text="Export Format" FontSize="{DynamicResource Nyforge.Type.Body}"
                         Foreground="{DynamicResource Nyforge.Brush.TextPrimary}" />
              <Grid ColumnDefinitions="*,Auto">
                <ComboBox Grid.Column="0" SelectedIndex="0">
                  <ComboBoxItem Content=".nstudio (NUI Document)" />
                  <ComboBoxItem Content="Rust (.rs)" IsEnabled="False" />
                  <ComboBoxItem Content="C++ (.hpp)" IsEnabled="False" />
                  <ComboBoxItem Content="Python (.py)" IsEnabled="False" />
                </ComboBox>
              </Grid>

              <CheckBox Content="Validate before export" IsChecked="True"
                        FontSize="{DynamicResource Nyforge.Type.Body}" />
              <CheckBox Content="Run NUI validator in CI mode" IsChecked="False"
                        FontSize="{DynamicResource Nyforge.Type.Body}" />
            </StackPanel>
          </StackPanel>

          <Border Classes="separator" Margin="0,8" />

          <!-- KEYBOARD SHORTCUTS SECTION -->
          <StackPanel Spacing="12">
            <TextBlock Text="Keyboard Shortcuts" FontSize="{DynamicResource Nyforge.Type.Title}"
                       FontWeight="SemiBold" Foreground="{DynamicResource Nyforge.Brush.TextPrimary}" />

            <TextBlock Text="Global keyboard shortcuts for Nyforge." FontSize="{DynamicResource Nyforge.Type.Body}"
                       Foreground="{DynamicResource Nyforge.Brush.TextSecondary}" TextWrapping="Wrap" />

            <Border Classes="separator" />

            <!-- Shortcut table -->
            <Border Background="{DynamicResource Nyforge.Brush.SurfaceElevated}"
                    CornerRadius="{DynamicResource Nyforge.Radius.Medium}" Padding="4">
              <StackPanel Spacing="0">
                <!-- Header -->
                <Grid ColumnDefinitions="*,*" Margin="12,8" Background="{DynamicResource Nyforge.Brush.SurfaceOverlay}">
                  <TextBlock Text="Action" FontWeight="SemiBold" FontSize="{DynamicResource Nyforge.Type.Caption}"
                             Foreground="{DynamicResource Nyforge.Brush.TextSecondary}" />
                  <TextBlock Grid.Column="1" Text="Shortcut" FontWeight="SemiBold" FontSize="{DynamicResource Nyforge.Type.Caption}"
                             Foreground="{DynamicResource Nyforge.Brush.TextSecondary}" HorizontalAlignment="Right" />
                </Grid>
                <Border Classes="separator" />

                <!-- Shortcuts -->
                <Grid ColumnDefinitions="*,*" Margin="12,6">
                  <TextBlock Text="New Project" FontSize="{DynamicResource Nyforge.Type.Body}" Foreground="{DynamicResource Nyforge.Brush.TextPrimary}" />
                  <TextBlock Grid.Column="1" Text="Ctrl+N" FontSize="{DynamicResource Nyforge.Type.Caption}" Foreground="{DynamicResource Nyforge.Brush.TextSecondary}" HorizontalAlignment="Right" />
                </Grid>
                <Grid ColumnDefinitions="*,*" Margin="12,6" Background="{DynamicResource Nyforge.Brush.Hover}">
                  <TextBlock Text="Open Project" FontSize="{DynamicResource Nyforge.Type.Body}" Foreground="{DynamicResource Nyforge.Brush.TextPrimary}" />
                  <TextBlock Grid.Column="1" Text="Ctrl+O" FontSize="{DynamicResource Nyforge.Type.Caption}" Foreground="{DynamicResource Nyforge.Brush.TextSecondary}" HorizontalAlignment="Right" />
                </Grid>
                <Grid ColumnDefinitions="*,*" Margin="12,6">
                  <TextBlock Text="Save" FontSize="{DynamicResource Nyforge.Type.Body}" Foreground="{DynamicResource Nyforge.Brush.TextPrimary}" />
                  <TextBlock Grid.Column="1" Text="Ctrl+S" FontSize="{DynamicResource Nyforge.Type.Caption}" Foreground="{DynamicResource Nyforge.Brush.TextSecondary}" HorizontalAlignment="Right" />
                </Grid>
                <Grid ColumnDefinitions="*,*" Margin="12,6" Background="{DynamicResource Nyforge.Brush.Hover}">
                  <TextBlock Text="Save As" FontSize="{DynamicResource Nyforge.Type.Body}" Foreground="{DynamicResource Nyforge.Brush.TextPrimary}" />
                  <TextBlock Grid.Column="1" Text="Ctrl+Shift+S" FontSize="{DynamicResource Nyforge.Type.Caption}" Foreground="{DynamicResource Nyforge.Brush.TextSecondary}" HorizontalAlignment="Right" />
                </Grid>
                <Grid ColumnDefinitions="*,*" Margin="12,6">
                  <TextBlock Text="Undo" FontSize="{DynamicResource Nyforge.Type.Body}" Foreground="{DynamicResource Nyforge.Brush.TextPrimary}" />
                  <TextBlock Grid.Column="1" Text="Ctrl+Z" FontSize="{DynamicResource Nyforge.Type.Caption}" Foreground="{DynamicResource Nyforge.Brush.TextSecondary}" HorizontalAlignment="Right" />
                </Grid>
                <Grid ColumnDefinitions="*,*" Margin="12,6" Background="{DynamicResource Nyforge.Brush.Hover}">
                  <TextBlock Text="Redo" FontSize="{DynamicResource Nyforge.Type.Body}" Foreground="{DynamicResource Nyforge.Brush.TextPrimary}" />
                  <TextBlock Grid.Column="1" Text="Ctrl+Shift+Z" FontSize="{DynamicResource Nyforge.Type.Caption}" Foreground="{DynamicResource Nyforge.Brush.TextSecondary}" HorizontalAlignment="Right" />
                </Grid>
                <Grid ColumnDefinitions="*,*" Margin="12,6">
                  <TextBlock Text="Copy" FontSize="{DynamicResource Nyforge.Type.Body}" Foreground="{DynamicResource Nyforge.Brush.TextPrimary}" />
                  <TextBlock Grid.Column="1" Text="Ctrl+C" FontSize="{DynamicResource Nyforge.Type.Caption}" Foreground="{DynamicResource Nyforge.Brush.TextSecondary}" HorizontalAlignment="Right" />
                </Grid>
                <Grid ColumnDefinitions="*,*" Margin="12,6" Background="{DynamicResource Nyforge.Brush.Hover}">
                  <TextBlock Text="Paste" FontSize="{DynamicResource Nyforge.Type.Body}" Foreground="{DynamicResource Nyforge.Brush.TextPrimary}" />
                  <TextBlock Grid.Column="1" Text="Ctrl+V" FontSize="{DynamicResource Nyforge.Type.Caption}" Foreground="{DynamicResource Nyforge.Brush.TextSecondary}" HorizontalAlignment="Right" />
                </Grid>
                <Grid ColumnDefinitions="*,*" Margin="12,6">
                  <TextBlock Text="Delete" FontSize="{DynamicResource Nyforge.Type.Body}" Foreground="{DynamicResource Nyforge.Brush.TextPrimary}" />
                  <TextBlock Grid.Column="1" Text="Delete" FontSize="{DynamicResource Nyforge.Type.Caption}" Foreground="{DynamicResource Nyforge.Brush.TextSecondary}" HorizontalAlignment="Right" />
                </Grid>
                <Grid ColumnDefinitions="*,*" Margin="12,6" Background="{DynamicResource Nyforge.Brush.Hover}">
                  <TextBlock Text="Preview" FontSize="{DynamicResource Nyforge.Type.Body}" Foreground="{DynamicResource Nyforge.Brush.TextPrimary}" />
                  <TextBlock Grid.Column="1" Text="F5" FontSize="{DynamicResource Nyforge.Type.Caption}" Foreground="{DynamicResource Nyforge.Brush.TextSecondary}" HorizontalAlignment="Right" />
                </Grid>
                <Grid ColumnDefinitions="*,*" Margin="12,6">
                  <TextBlock Text="Nudge" FontSize="{DynamicResource Nyforge.Type.Body}" Foreground="{DynamicResource Nyforge.Brush.TextPrimary}" />
                  <TextBlock Grid.Column="1" Text="Arrow Keys" FontSize="{DynamicResource Nyforge.Type.Caption}" Foreground="{DynamicResource Nyforge.Brush.TextSecondary}" HorizontalAlignment="Right" />
                </Grid>
                <Grid ColumnDefinitions="*,*" Margin="12,6" Background="{DynamicResource Nyforge.Brush.Hover}">
                  <TextBlock Text="Nudge ×5" FontSize="{DynamicResource Nyforge.Type.Body}" Foreground="{DynamicResource Nyforge.Brush.TextPrimary}" />
                  <TextBlock Grid.Column="1" Text="Shift+Arrow" FontSize="{DynamicResource Nyforge.Type.Caption}" Foreground="{DynamicResource Nyforge.Brush.TextSecondary}" HorizontalAlignment="Right" />
                </Grid>
                <Grid ColumnDefinitions="*,*" Margin="12,6">
                  <TextBlock Text="Preferences" FontSize="{DynamicResource Nyforge.Type.Body}" Foreground="{DynamicResource Nyforge.Brush.TextPrimary}" />
                  <TextBlock Grid.Column="1" Text="Ctrl+," FontSize="{DynamicResource Nyforge.Type.Caption}" Foreground="{DynamicResource Nyforge.Brush.TextSecondary}" HorizontalAlignment="Right" />
                </Grid>
                <Grid ColumnDefinitions="*,*" Margin="12,6" Background="{DynamicResource Nyforge.Brush.Hover}">
                  <TextBlock Text="Command Palette" FontSize="{DynamicResource Nyforge.Type.Body}" Foreground="{DynamicResource Nyforge.Brush.TextPrimary}" />
                  <TextBlock Grid.Column="1" Text="Ctrl+K" FontSize="{DynamicResource Nyforge.Type.Caption}" Foreground="{DynamicResource Nyforge.Brush.TextSecondary}" HorizontalAlignment="Right" />
                </Grid>
                <Grid ColumnDefinitions="*,*" Margin="12,6">
                  <TextBlock Text="Toggle Theme" FontSize="{DynamicResource Nyforge.Type.Body}" Foreground="{DynamicResource Nyforge.Brush.TextPrimary}" />
                  <TextBlock Grid.Column="1" Text="Ctrl+Shift+T" FontSize="{DynamicResource Nyforge.Type.Caption}" Foreground="{DynamicResource Nyforge.Brush.TextSecondary}" HorizontalAlignment="Right" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Bottom bar -->
    <Border Grid.Row="1" Background="{DynamicResource Nyforge.Brush.Surface}"
            BorderBrush="{DynamicResource Nyforge.Brush.Separator}" BorderThickness="0,1,0,0"
            Padding="16,10" HorizontalAlignment="Right">
      <Button Content="Done" Classes="primary" MinWidth="80"
              Click="OnDone" />
    </Border>

  </Grid>

</Window>
