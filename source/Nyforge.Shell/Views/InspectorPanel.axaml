<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nyforge.Shell.ViewModels"
             x:Class="Nyforge.Shell.Views.InspectorPanel"
             x:DataType="vm:MainWindowViewModel">

  <DockPanel Background="{DynamicResource Nyforge.Brush.Surface}">
    <TextBlock DockPanel.Dock="Top" Classes="section-header"
               Text="INSPECTOR"
               Margin="{DynamicResource Nyforge.Margin.SectionHeader}" />

    <Panel>
      <StackPanel IsVisible="{Binding !HasSelection}" Margin="{DynamicResource Nyforge.Margin.Panel}" Spacing="{DynamicResource Nyforge.Space.1}">
        <TextBlock Classes="field-label" Text="Nothing selected." />
      </StackPanel>

      <!-- The IsVisible toggle binds on MainWindowViewModel, so the
           DataContext override to the selected element moves one level
           down: the outer panel keeps the root VM type for its own
           bindings (compiled bindings are statically typed). -->
      <StackPanel IsVisible="{Binding HasSelection}" Margin="{DynamicResource Nyforge.Margin.Panel}">
        <StackPanel Spacing="{DynamicResource Nyforge.Space.2}"
                    DataContext="{Binding SelectedElement}"
                    x:DataType="vm:CanvasElementViewModel">
          <StackPanel Spacing="{DynamicResource Nyforge.Space.1}">
          <TextBlock Classes="field-label" Text="Id" />
          <TextBlock Text="{Binding Id}" FontSize="{DynamicResource Nyforge.Type.Body}"
                     Foreground="{DynamicResource Nyforge.Brush.TextPrimary}" />
        </StackPanel>

        <StackPanel Spacing="{DynamicResource Nyforge.Space.1}">
          <TextBlock Classes="field-label" Text="Type" />
          <TextBlock Text="{Binding Type}" FontSize="{DynamicResource Nyforge.Type.Body}"
                     Foreground="{DynamicResource Nyforge.Brush.TextPrimary}" />
        </StackPanel>

        <TextBlock Classes="section-header" Text="POSITION"
                   Margin="{DynamicResource Nyforge.Margin.SectionTop}" />
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" >
          <TextBlock Grid.Row="0" Grid.Column="0" Classes="field-label" Text="X" />
          <TextBlock Grid.Row="0" Grid.Column="1" Classes="field-label" Text="Y" />
          <NumericUpDown Grid.Row="1" Grid.Column="0" Value="{Binding X}" Margin="0,2,4,0" />
          <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Y}" Margin="4,2,0,0" />
        </Grid>

        <TextBlock Classes="section-header" Text="SIZE"
                   Margin="{DynamicResource Nyforge.Margin.SectionTop}" />
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Classes="field-label" Text="Width" />
          <TextBlock Grid.Row="0" Grid.Column="1" Classes="field-label" Text="Height" />
          <NumericUpDown Grid.Row="1" Grid.Column="0" Value="{Binding Width}" Margin="0,2,4,0" />
          <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Height}" Margin="4,2,0,0" />
        </Grid>

        <TextBlock Classes="section-header" Text="PROPERTIES"
                   Margin="{DynamicResource Nyforge.Margin.SectionTop}" />

        <!-- Metadata-driven (NFS-006): one editor per property, chosen
             from the registry's PropertyDefinition.Type — string → text
             box, boolean → checkbox, number → numeric up-down, enum →
             combo box, array → read-only text.  Writes route through
             MainWindowViewModel's undoable history. -->
        <ItemsControl ItemsSource="{Binding PropertyEditors}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PropertyEditorViewModel">
              <StackPanel Spacing="{DynamicResource Nyforge.Space.1}" Margin="0,4,0,0">
                <TextBlock Classes="field-label" Text="{Binding Name}" />

                <TextBox Text="{Binding Value, Mode=TwoWay}"
                         Watermark="(text)"
                         IsVisible="{Binding IsStringEditor}" />

                <CheckBox Content="{Binding Name}" IsChecked="{Binding Value, Mode=TwoWay}"
                          IsVisible="{Binding IsBooleanEditor}" />

                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsNumberEditor}">
                  <NumericUpDown Value="{Binding Value, Mode=TwoWay}"
                                 Minimum="{Binding Min}" Maximum="{Binding Max}"
                                 FormatString="0.##" />
                  <TextBlock Grid.Column="1" Classes="field-label"
                             Text="{Binding Units}" VerticalAlignment="Center"
                             Margin="4,0,0,0" />
                </Grid>

                <ComboBox ItemsSource="{Binding EnumValues}"
                          SelectedItem="{Binding Value, Mode=TwoWay}"
                          IsVisible="{Binding IsEnumEditor}" />

                <TextBlock Classes="field-label" Text="(array)"
                           IsVisible="{Binding IsArrayEditor}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        </StackPanel>
      </StackPanel>
    </Panel>
  </DockPanel>

</UserControl>
