<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Nyforge.Shell.ViewModels"
        xmlns:views="using:Nyforge.Shell.Views"
        x:Class="Nyforge.Shell.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Nyrqis Forge"
        Width="1280" Height="820"
        Background="{DynamicResource Nyforge.Brush.Background}"
        KeyDown="OnKeyDown">

  <DockPanel>

    <!-- Menu bar -->
    <Menu DockPanel.Dock="Top" Background="{DynamicResource Nyforge.Brush.Surface}">
      <MenuItem Header="_File">
        <MenuItem Header="_New Project" Click="OnNewProject" />
        <MenuItem Header="_Open..." Click="OnOpenProject" />
        <Separator />
        <MenuItem Header="_Save" Click="OnSaveProject" />
        <MenuItem Header="Save _As..." Click="OnSaveProjectAs" />
        <Separator />
        <MenuItem Header="Customize Home Screen..." Click="OnCustomizeHomeScreen"
                  ToolTip.Tip="Point Forge's own Home tab at any .nstudio file you design — see docs/how-to/redesigning-the-home-screen.md" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="Undo" Command="{Binding UndoCommand}" HotKey="Ctrl+Z" />
        <MenuItem Header="Redo" Command="{Binding RedoCommand}" HotKey="Ctrl+Y" />
        <Separator />
        <MenuItem Header="Copy" Command="{Binding CopySelectionCommand}" HotKey="Ctrl+C" />
        <MenuItem Header="Paste" Command="{Binding PasteCommand}" HotKey="Ctrl+V" />
        <Separator />
        <MenuItem Header="Delete Selected" Command="{Binding DeleteSelectedCommand}" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="Theme">
          <MenuItem Header="Eclipse" Command="{Binding SetThemeCommand}" CommandParameter="Eclipse" />
          <MenuItem Header="Solar" Command="{Binding SetThemeCommand}" CommandParameter="Solar" />
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_Build" />
      <MenuItem Header="_Preview" />
      <MenuItem Header="_Export" />
    </Menu>

    <!-- Bottom status / run bar (spacing on the 4px grid, primary action
         emphasized — docs/reference/design-system.md) -->
    <Grid DockPanel.Dock="Bottom" Background="{DynamicResource Nyforge.Brush.Surface}"
          ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" Height="36">
      <Button Grid.Column="0" Content="▶ Preview" Classes="primary" Margin="{DynamicResource Nyforge.Margin.StatusButton}" Click="OnPreview" />
      <Button Grid.Column="1" Content="▶ Run in Nyrqis" Classes="toolbar" Margin="{DynamicResource Nyforge.Margin.StatusButtonSide}"
              Click="OnRunInNyrqis"
              ToolTip.Tip="Export the current NUI document to the Nyrqis runtime" />
      <Button Grid.Column="2" Content="Build" Classes="toolbar" Margin="{DynamicResource Nyforge.Margin.StatusButton}" IsEnabled="False"
              ToolTip.Tip="Code-gen exporters are deferred (doc #21)" />
      <Button Grid.Column="3" Content="Export NUI" Classes="toolbar" Margin="{DynamicResource Nyforge.Margin.StatusButtonSide}" Click="OnExportNui" />
      <TextBlock Grid.Column="5" Text="{Binding StatusMessage}" VerticalAlignment="Center"
                 Margin="{DynamicResource Nyforge.Margin.StatusText}"
                 Foreground="{DynamicResource Nyforge.Brush.TextSecondary}"
                 FontSize="{DynamicResource Nyforge.Type.Caption}" />
    </Grid>

    <!-- Home (self-hosted, NFS-004) vs. Design (the editor itself) -->
    <TabControl>
      <TabItem Header="Home">
        <views:HomePanel DataContext="{Binding Home}" />
      </TabItem>

      <TabItem Header="Design">
        <!-- Main 3-panel layout: Palette | Canvas | Inspector, with a bottom tab strip -->
        <Grid ColumnDefinitions="220,*,260" RowDefinitions="*,180">

          <views:ComponentPalette Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" />

          <ScrollViewer Grid.Column="1" Grid.Row="0">
            <views:DesignCanvas Margin="{DynamicResource Nyforge.Margin.Canvas}" />
          </ScrollViewer>

          <views:InspectorPanel Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" />

          <TabControl Grid.Column="1" Grid.Row="1" Background="{DynamicResource Nyforge.Brush.Surface}">
            <TabItem Header="Layers">
              <views:LayersPanel />
            </TabItem>
            <TabItem Header="State">
              <TextBlock Text="State editor — v0.4." Margin="12" Foreground="{DynamicResource Nyforge.Brush.TextSecondary}" />
            </TabItem>
            <TabItem Header="Events">
              <views:BehaviorsPanel />
            </TabItem>
            <TabItem Header="Animations">
              <views:AnimationsPanel />
            </TabItem>
            <TabItem Header="Data">
              <TextBlock Text="Bindings editor UI — v0.4. Bindings themselves are implemented (NUI-SCHEMA.md §8) and exercised in Preview; there's just no visual editor for them yet, only hand-editing the .nstudio file."
                         Margin="12" TextWrapping="Wrap" Foreground="{DynamicResource Nyforge.Brush.TextSecondary}" />
            </TabItem>
          </TabControl>

        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>

</Window>
