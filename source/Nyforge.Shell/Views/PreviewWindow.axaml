<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Nyforge.Shell.ViewModels"
        x:Class="Nyforge.Shell.Views.PreviewWindow"
        x:DataType="vm:PreviewViewModel"
        Title="Nyforge Preview"
        Width="1200" Height="820"
        Background="{DynamicResource Nyforge.Brush.Background}">

  <Grid RowDefinitions="Auto,*,200">

    <!-- Info banner -->
    <Border Grid.Row="0" Background="{DynamicResource Nyforge.Brush.AccentMuted}"
            Padding="16,10">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="ℹ️" FontSize="14" VerticalAlignment="Center" />
        <TextBlock Text="This is Forge's preview renderer — not the real Nyrqis runtime. Interactions are simulated."
                   FontSize="{DynamicResource Nyforge.Type.Body}" TextWrapping="Wrap"
                   Foreground="{DynamicResource Nyforge.Brush.TextPrimary}" />
      </StackPanel>
    </Border>

    <!-- Preview canvas -->
    <Border Grid.Row="1" Background="{DynamicResource Nyforge.Brush.Surface}"
            BorderBrush="{DynamicResource Nyforge.Brush.Separator}" BorderThickness="0,1,0,0">
      <Canvas Background="{DynamicResource Nyforge.Brush.Surface}">
        <ItemsControl ItemsSource="{Binding Elements}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <Canvas />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>

          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:PreviewElementViewModel">
              <ContentControl Width="{Binding Width}" Height="{Binding Height}"
                               Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}"
                               Content="{Binding}">
                <ContentControl.ContentTemplate>
                  <DataTemplate DataType="vm:PreviewElementViewModel">
                    <Panel>
                      <!-- Button -->
                      <Button Content="{Binding Text}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Classes="primary"
                              IsVisible="{Binding Type, Converter={x:Static vm:PreviewTypeConverters.IsButton}}"
                              Click="OnButtonClicked" Tag="{Binding}" />

                      <!-- Toggle / Checkbox / Radio -->
                      <CheckBox Content="{Binding Text}" IsChecked="{Binding BoolValue}"
                                 IsVisible="{Binding Type, Converter={x:Static vm:PreviewTypeConverters.IsToggleLike}}"
                                 Checked="OnToggleChanged" Unchecked="OnToggleChanged" Tag="{Binding}" />

                      <!-- Text / Label / Heading / Paragraph -->
                      <TextBlock Text="{Binding Text}" VerticalAlignment="Center"
                                 FontSize="{DynamicResource Nyforge.Type.Body}"
                                 Foreground="{DynamicResource Nyforge.Brush.TextPrimary}"
                                 IsVisible="{Binding Type, Converter={x:Static vm:PreviewTypeConverters.IsText}}" />

                      <!-- Slider -->
                      <Slider Minimum="0" Maximum="100" Value="50" HorizontalAlignment="Stretch"
                              IsVisible="{Binding Type, Converter={x:Static vm:PreviewTypeConverters.IsSlider}}" />

                      <!-- ProgressBar -->
                      <ProgressBar Minimum="0" Maximum="100" Value="60" HorizontalAlignment="Stretch"
                                   IsVisible="{Binding Type, Converter={x:Static vm:PreviewTypeConverters.IsProgressBar}}" />

                      <!-- Image (placeholder) -->
                      <Border Background="{DynamicResource Nyforge.Brush.SurfaceElevated}"
                              CornerRadius="{DynamicResource Nyforge.Radius.Medium}"
                              BorderBrush="{DynamicResource Nyforge.Brush.Separator}" BorderThickness="1"
                              IsVisible="{Binding Type, Converter={x:Static vm:PreviewTypeConverters.IsImage}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                          <TextBlock Text="🖼️" FontSize="20" HorizontalAlignment="Center" />
                          <TextBlock Text="Image" FontSize="{DynamicResource Nyforge.Type.Caption}"
                                     Foreground="{DynamicResource Nyforge.Brush.TextSecondary}"
                                     HorizontalAlignment="Center" />
                        </StackPanel>
                      </Border>

                      <!-- Generic placeholder -->
                      <Border Background="{DynamicResource Nyforge.Brush.SurfaceElevated}"
                              BorderBrush="{DynamicResource Nyforge.Brush.Separator}" BorderThickness="1"
                              CornerRadius="{DynamicResource Nyforge.Radius.Small}"
                              IsVisible="{Binding Type, Converter={x:Static vm:PreviewTypeConverters.IsPlaceholder}}">
                        <TextBlock Text="{Binding Type}" FontSize="{DynamicResource Nyforge.Type.Caption}"
                                   Margin="8"
                                   Foreground="{DynamicResource Nyforge.Brush.TextTertiary}" />
                      </Border>
                    </Panel>
                  </DataTemplate>
                </ContentControl.ContentTemplate>
              </ContentControl>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Canvas>
    </Border>

    <!-- Event log -->
    <Border Grid.Row="2" Background="{DynamicResource Nyforge.Brush.SurfaceOverlay}"
            BorderBrush="{DynamicResource Nyforge.Brush.Separator}" BorderThickness="0,1,0,0"
            Padding="12">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <TextBlock Text="Event Log" FontSize="{DynamicResource Nyforge.Type.Subhead}"
                     FontWeight="SemiBold" Foreground="{DynamicResource Nyforge.Brush.TextPrimary}" />
        </DockPanel>
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Log}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding}" FontSize="{DynamicResource Nyforge.Type.Caption}"
                           Foreground="{DynamicResource Nyforge.Brush.TextSecondary}"
                           Margin="0,1" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

  </Grid>

</Window>
