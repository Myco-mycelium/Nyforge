<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nyforge.Shell.ViewModels"
             x:Class="Nyforge.Shell.Views.BehaviorsPanel"
             x:DataType="vm:MainWindowViewModel"
             x:Name="Root">

  <!--
    Buttons/ComboBoxes inside the ItemsControl.ItemTemplate below need to
    reach commands and lists that live on the outer MainWindowViewModel,
    not on the per-item BehaviorViewModel. Because compiled bindings are
    enabled, DataContext is statically typed as object, so reaching the
    VM requires the cast syntax ((vm:MainWindowViewModel)DataContext)
    anchored on the named root element (#Root).

    The condition graph is rendered by the self-referencing
    ConditionNodeTemplate (a leaf or an AND/OR group whose children are
    themselves leaves or groups — NUI-SCHEMA §7.3). The node's own
    commands (add leaf / add group / remove self) live on
    ConditionNodeViewModel; the behavior's chain commands (add / remove /
    reorder steps) live on BehaviorViewModel and are reached through each
    step's Owner.
  -->
  <UserControl.Resources>
    <DataTemplate x:Key="ConditionNodeTemplate" x:DataType="vm:ConditionNodeViewModel">
      <Border BorderBrush="{DynamicResource Nyforge.Brush.BorderSubtle}"
              BorderThickness="1"
              CornerRadius="{DynamicResource Nyforge.Radius.Small}"
              Padding="6" Margin="0,2,0,0">
        <StackPanel Spacing="4">

          <!-- Group header: AND/OR toggle + remove -->
          <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding IsGroup}">
            <ComboBox Grid.Column="0" Width="76" FontSize="11"
                      ItemsSource="{Binding LogicOptions}"
                      SelectedItem="{Binding Logic}" />
            <TextBlock Grid.Column="1" Text="group" FontSize="10"
                       Foreground="{DynamicResource Nyforge.Brush.TextSecondary}"
                       VerticalAlignment="Center" Margin="6,0" />
            <Button Grid.Column="2" Content="✕" Padding="4,0"
                    Command="{Binding RemoveSelfCommand}" />
          </Grid>

          <!-- Children (groups only) -->
          <ItemsControl Grid.Column="0" ItemsSource="{Binding Children}"
                        ItemTemplate="{StaticResource ConditionNodeTemplate}"
                        IsVisible="{Binding IsGroup}" />

          <!-- Add leaf / add group (groups only) -->
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsGroup}">
            <Button Content="+ leaf" FontSize="11" Padding="6,1"
                    Command="{Binding AddLeafCommand}" />
            <Button Content="+ group" FontSize="11" Padding="6,1"
                    Command="{Binding AddGroupCommand}" />
          </StackPanel>

          <!-- Leaf editor: expression mode or legacy equality -->
          <StackPanel IsVisible="{Binding IsLeaf}">
            <CheckBox Content="expression" FontSize="11"
                      IsChecked="{Binding UsesExpression}" />
            <TextBox Text="{Binding Expression}"
                     Watermark="e.g. state.volume > 50"
                     FontSize="11" Margin="0,2,0,0"
                     IsVisible="{Binding UsesExpression}" />
            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto" Margin="0,2,0,0"
                  IsVisible="{Binding !UsesExpression}">
              <TextBlock Grid.Column="0" Classes="field-label" Text="state"
                         VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Text="{Binding State}" FontSize="11" Margin="4,0" />
              <ComboBox Grid.Column="2" Width="88" FontSize="11"
                        ItemsSource="{Binding OperatorOptions}"
                        SelectedItem="{Binding Operator}" />
              <TextBlock Grid.Column="3" Classes="field-label" Text="value"
                         VerticalAlignment="Center" Margin="6,0,0,0" />
              <TextBox Grid.Column="4" Text="{Binding Value}" FontSize="11" Margin="4,0" />
              <Button Grid.Column="6" Content="✕" Padding="4,0" Margin="6,0,0,0"
                      Command="{Binding RemoveSelfCommand}" />
            </Grid>
          </StackPanel>

        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid ColumnDefinitions="220,*" Margin="8">

    <!-- Left: attach a new behavior to an unbound event on the selection -->
    <StackPanel Grid.Column="0" Spacing="{DynamicResource Nyforge.Space.1}" Margin="{DynamicResource Nyforge.Margin.BehaviorsLeft}">
      <TextBlock Classes="section-header" Text="ADD BEHAVIOR" />

      <TextBlock Classes="field-label"
                 Text="Select an element with an unbound event, then choose which one to wire up:"
                 TextWrapping="Wrap"
                 IsVisible="{Binding !HasSelection}" />

      <ItemsControl ItemsSource="{Binding AvailableEventsForSelection}" IsVisible="{Binding HasSelection}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Content="{Binding}" Margin="0,2" HorizontalAlignment="Stretch"
                    Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).AddBehaviorForSelectedCommand}"
                    CommandParameter="{Binding}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="All events on this element are already bound."
                 FontSize="11" TextWrapping="Wrap"
                 Foreground="{DynamicResource Nyforge.Brush.TextSecondary}"
                 IsVisible="{Binding NoUnboundEventsOnSelection}" />
    </StackPanel>

    <!-- Right: the list of all wired-up behaviors on this screen -->
    <ScrollViewer Grid.Column="1">
      <ItemsControl ItemsSource="{Binding Behaviors}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:BehaviorViewModel">
            <Border Background="{DynamicResource Nyforge.Brush.SurfaceElevated}"
                    CornerRadius="{DynamicResource Nyforge.Radius.Small}"
                    Padding="{DynamicResource Nyforge.Padding.Card}" Margin="{DynamicResource Nyforge.Margin.BehaviorCard}">
              <StackPanel Spacing="{DynamicResource Nyforge.Space.1}">

                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="{Binding Summary}" FontSize="{DynamicResource Nyforge.Type.Body}"
                             Foreground="{DynamicResource Nyforge.Brush.TextPrimary}"
                             TextWrapping="Wrap" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Content="✕" Padding="6,2"
                          Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).RemoveBehaviorCommand}"
                          CommandParameter="{Binding}" />
                </Grid>

                <!-- DO: the action chain (NUI-SCHEMA §7.3) -->
                <TextBlock Classes="field-label" Text="DO" />

                <ItemsControl ItemsSource="{Binding Steps}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:ActionStepViewModel">
                      <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,Auto,Auto" Margin="0,2">
                        <TextBlock Grid.Column="0" Classes="field-label" Text="target"
                                   VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" Margin="4,0"
                                  ItemsSource="{Binding #Root.((vm:MainWindowViewModel)DataContext).AvailableActionTargets}"
                                  SelectedItem="{Binding Target}" />
                        <TextBlock Grid.Column="2" Text="." VerticalAlignment="Center"
                                   Foreground="{DynamicResource Nyforge.Brush.TextSecondary}" />
                        <ComboBox Grid.Column="3" Margin="4,0"
                                  ItemsSource="{Binding AvailableActionNames}"
                                  SelectedItem="{Binding Name}" />
                        <Button Grid.Column="4" Content="↑" Padding="4,1"
                                Command="{Binding Owner.MoveStepUpCommand}"
                                CommandParameter="{Binding}" />
                        <Button Grid.Column="5" Content="↓" Padding="4,1"
                                Command="{Binding Owner.MoveStepDownCommand}"
                                CommandParameter="{Binding}" />
                        <Button Grid.Column="6" Content="✕" Padding="4,1"
                                Command="{Binding Owner.RemoveStepCommand}"
                                CommandParameter="{Binding}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="+ add action" FontSize="11" Padding="6,1"
                        HorizontalAlignment="Left"
                        Command="{Binding AddStepCommand}" />

                <!-- IF: the condition graph (NUI-SCHEMA §7.3) -->
                <CheckBox Content="Only if..." IsChecked="{Binding HasCondition}" FontSize="11" />

                <ContentControl Content="{Binding ConditionRoot}"
                                ContentTemplate="{StaticResource ConditionNodeTemplate}"
                                IsVisible="{Binding HasCondition}" />

              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

  </Grid>

</UserControl>
