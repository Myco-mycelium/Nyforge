<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nyforge.Shell.ViewModels"
             x:Class="Nyforge.Shell.Views.BehaviorsPanel"
             x:DataType="vm:MainWindowViewModel"
             x:Name="Root">

  <!--
    Buttons/ComboBoxes inside the ItemsControl.ItemTemplate below need to
    reach commands and lists that live on the outer MainWindowViewModel,
    not on the per-item BehaviorViewModel. Rather than the more error-prone
    "$parent[Type].((cast)DataContext)" binding syntax, this uses a named
    root element (#Root) and walks .DataContext explicitly — plain element-
    name binding, the most standard and least ambiguous way to reach
    outside a DataTemplate in Avalonia.
  -->
  <Grid ColumnDefinitions="220,*" Margin="8">

    <!-- Left: attach a new behavior to an unbound event on the selection -->
    <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,12,0">
      <TextBlock Text="ADD BEHAVIOR" FontSize="10" FontWeight="Bold"
                 Foreground="{DynamicResource Nyforge.Brush.TextSecondary}" />

      <TextBlock Text="Select an element with an unbound event, then choose which one to wire up:"
                 FontSize="11" TextWrapping="Wrap"
                 Foreground="{DynamicResource Nyforge.Brush.TextSecondary}"
                 IsVisible="{Binding !HasSelection}" />

      <ItemsControl ItemsSource="{Binding AvailableEventsForSelection}" IsVisible="{Binding HasSelection}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Content="{Binding}" Margin="0,2" HorizontalAlignment="Stretch"
                    Command="{Binding #Root.DataContext.AddBehaviorForSelectedCommand}"
                    CommandParameter="{Binding}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="All events on this element are already bound."
                 FontSize="11" TextWrapping="Wrap"
                 Foreground="{DynamicResource Nyforge.Brush.TextSecondary}"
                 IsVisible="{Binding NoUnboundEventsOnSelection}" />
    </StackPanel>

    <!-- Right: the list of all wired-up behaviors on this screen -->
    <ScrollViewer Grid.Column="1">
      <ItemsControl ItemsSource="{Binding Behaviors}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:BehaviorViewModel">
            <Border Background="{DynamicResource Nyforge.Brush.SurfaceElevated}"
                    CornerRadius="4" Padding="10" Margin="0,0,0,8">
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="{Binding Summary}" FontSize="12"
                             Foreground="{DynamicResource Nyforge.Brush.TextPrimary}"
                             TextWrapping="Wrap" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Content="✕" Padding="6,2"
                          Command="{Binding #Root.DataContext.RemoveBehaviorCommand}"
                          CommandParameter="{Binding}" />
                </Grid>

                <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto" >
                  <TextBlock Grid.Column="0" Text="DO" VerticalAlignment="Center" Margin="0,0,6,0"
                             FontSize="11" Foreground="{DynamicResource Nyforge.Brush.TextSecondary}" />
                  <ComboBox Grid.Column="1" Margin="0,0,10,0"
                            ItemsSource="{Binding #Root.DataContext.AvailableActionTargets}"
                            SelectedItem="{Binding ActionTarget}" />
                  <TextBlock Grid.Column="2" Text="." VerticalAlignment="Center" Margin="0,0,6,0"
                             Foreground="{DynamicResource Nyforge.Brush.TextSecondary}" />
                  <ComboBox Grid.Column="3" ItemsSource="{Binding AvailableActionNames}"
                            SelectedItem="{Binding ActionName}" />
                </Grid>

                <CheckBox Content="Only if..." IsChecked="{Binding HasCondition}" FontSize="11" />

                <Grid ColumnDefinitions="Auto,*,Auto,*" IsVisible="{Binding HasCondition}">
                  <TextBlock Grid.Column="0" Text="state" VerticalAlignment="Center" Margin="0,0,6,0"
                             FontSize="11" Foreground="{DynamicResource Nyforge.Brush.TextSecondary}" />
                  <TextBox Grid.Column="1" Text="{Binding ConditionState}" Margin="0,0,10,0" Watermark="e.g. theme" />
                  <TextBlock Grid.Column="2" Text="equals" VerticalAlignment="Center" Margin="0,0,6,0"
                             FontSize="11" Foreground="{DynamicResource Nyforge.Brush.TextSecondary}" />
                  <TextBox Grid.Column="3" Text="{Binding ConditionValue}" Watermark="e.g. Eclipse" />
                </Grid>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

  </Grid>

</UserControl>
