<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nyforge.Shell.ViewModels"
             xmlns:nui="using:Nyforge.Core.Nui"
             x:Class="Nyforge.Shell.Views.ComponentPalette"
             x:DataType="vm:MainWindowViewModel">

  <DockPanel Background="{DynamicResource Nyforge.Brush.Surface}">
    <TextBlock DockPanel.Dock="Top" Text="COMPONENTS" FontSize="11" FontWeight="Bold"
               Foreground="{DynamicResource Nyforge.Brush.TextSecondary}"
               Margin="12,12,12,4" LetterSpacing="1" />

    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding PaletteItems}" Margin="4">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="nui:ComponentContract">
            <Border Padding="8,6" Margin="4,2" CornerRadius="4"
                    Background="{DynamicResource Nyforge.Brush.SurfaceElevated}"
                    DoubleTapped="OnPaletteItemDoubleTapped"
                    Tag="{Binding Type}"
                    Cursor="Hand"
                    ToolTip.Tip="Double-click to add to canvas">
              <TextBlock Text="{Binding Type}" Foreground="{DynamicResource Nyforge.Brush.TextPrimary}" FontSize="13" />
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>

</UserControl>
