<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nyforge.Shell.ViewModels"
             xmlns:nui="using:Nyforge.Core.Nui"
             x:Class="Nyforge.Shell.Views.ComponentPalette"
             x:DataType="vm:MainWindowViewModel">

  <DockPanel Background="{DynamicResource Nyforge.Brush.Surface}">
    <TextBlock DockPanel.Dock="Top" Classes="section-header"
               Text="COMPONENTS"
               Margin="{DynamicResource Nyforge.Margin.SectionHeader}" />

    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding PaletteItems}" Margin="{DynamicResource Nyforge.Inset.Small}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="nui:ComponentContract">
            <Border Classes="palette-item"
                    Padding="{DynamicResource Nyforge.Padding.PaletteItem}"
                    Margin="{DynamicResource Nyforge.Margin.PaletteItem}"
                    DoubleTapped="OnPaletteItemDoubleTapped"
                    Tag="{Binding Type}"
                    ToolTip.Tip="Double-click to add to canvas">
              <TextBlock Text="{Binding Type}"
                         Foreground="{DynamicResource Nyforge.Brush.TextPrimary}"
                         FontSize="{DynamicResource Nyforge.Type.Body}" />
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>

</UserControl>
