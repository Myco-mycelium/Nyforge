<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nyforge.Shell.ViewModels"
             x:Class="Nyforge.Shell.Views.LayersPanel"
             x:DataType="vm:MainWindowViewModel">

  <ListBox ItemsSource="{Binding CanvasElements}"
           SelectedItem="{Binding SelectedElement}"
           Background="Transparent"
           Padding="{DynamicResource Nyforge.Inset.Small}">
    <ListBox.ItemTemplate>
      <DataTemplate DataType="vm:CanvasElementViewModel">
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Nyforge.Space.2}">
          <TextBlock Text="{Binding Type}" FontSize="{DynamicResource Nyforge.Type.Body}"
                     Foreground="{DynamicResource Nyforge.Brush.TextPrimary}" />
          <TextBlock Text="{Binding Id}" FontSize="{DynamicResource Nyforge.Type.Caption}"
                     Foreground="{DynamicResource Nyforge.Brush.TextSecondary}" />
        </StackPanel>
      </DataTemplate>
    </ListBox.ItemTemplate>
  </ListBox>

</UserControl>
