<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nyforge.Shell.ViewModels"
             x:Class="Nyforge.Shell.Views.LayersPanel"
             x:DataType="vm:MainWindowViewModel">

  <ListBox ItemsSource="{Binding CanvasElements}"
           SelectedItem="{Binding SelectedElement}"
           Background="Transparent">
    <ListBox.ItemTemplate>
      <DataTemplate DataType="vm:CanvasElementViewModel">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{Binding Type}" FontSize="12" Foreground="{DynamicResource Nyforge.Brush.TextPrimary}" />
          <TextBlock Text="{Binding Id}" FontSize="11" Foreground="{DynamicResource Nyforge.Brush.TextSecondary}" />
        </StackPanel>
      </DataTemplate>
    </ListBox.ItemTemplate>
  </ListBox>

</UserControl>
