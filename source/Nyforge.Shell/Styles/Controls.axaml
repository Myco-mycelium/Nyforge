<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Apple-inspired control styles for Nyforge chrome.

    Design principles:
    - Pill-shaped primary buttons (Apple's signature)
    - Subtle hover/pressed transitions (0.15s ease)
    - Focus rings for keyboard accessibility
    - 8pt grid spacing
    - Category headers with uppercase tracking
    - Separator lines between sections

    Apply with Classes="..." on the control.
    All colors use DynamicResource so theme swaps re-skin in place.
  -->

  <!-- ============================================================
       SECTION HEADERS — uppercase, tracked, muted
       ============================================================ -->
  <Style Selector="TextBlock.section-header">
    <Setter Property="FontSize" Value="{DynamicResource Nyforge.Type.Caption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1.5" />
    <Setter Property="Foreground" Value="{DynamicResource Nyforge.Brush.TextSecondary}" />
    <Setter Property="Margin" Value="0,0,0,2" />
  </Style>

  <!-- ============================================================
       FIELD LABELS — small muted labels for inspector rows
       ============================================================ -->
  <Style Selector="TextBlock.field-label">
    <Setter Property="FontSize" Value="{DynamicResource Nyforge.Type.Caption}" />
    <Setter Property="Foreground" Value="{DynamicResource Nyforge.Brush.TextSecondary}" />
  </Style>

  <!-- Category label in palette (larger, bolder) -->
  <Style Selector="TextBlock.category-header">
    <Setter Property="FontSize" Value="{DynamicResource Nyforge.Type.Caption}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="0.8" />
    <Setter Property="Foreground" Value="{DynamicResource Nyforge.Brush.TextTertiary}" />
    <Setter Property="Margin" Value="4,10,4,4" />
  </Style>

  <!-- ============================================================
       CARDS — elevated surface with subtle border
       ============================================================ -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Nyforge.Brush.SurfaceElevated}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nyforge.Brush.Separator}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nyforge.Radius.Medium}" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <!-- ============================================================
       PALETTE ITEMS — hover + selected
       ============================================================ -->
  <Style Selector="Border.palette-item">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nyforge.Radius.Small}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Margin" Value="4,1" />
    <Setter Property="Padding" Value="10,6" />
  </Style>
  <Style Selector="Border.palette-item:pointerover">
    <Setter Property="Background" Value="{DynamicResource Nyforge.Brush.Hover}" />
  </Style>
  <Style Selector="Border.palette-item:selected">
    <Setter Property="Background" Value="{DynamicResource Nyforge.Brush.Selection}" />
  </Style>

  <!-- ============================================================
       PRIMARY BUTTON — pill shape, accent fill
       ============================================================ -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource Nyforge.Brush.Accent}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nyforge.Radius.Pill}" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="{DynamicResource Nyforge.Type.Body}" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Nyforge.Brush.AccentStrong}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Nyforge.Brush.Accent}" />
  </Style>

  <!-- ============================================================
       TOOLBAR BUTTON — flat, pill-shaped
       ============================================================ -->
  <Style Selector="Button.toolbar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nyforge.Brush.ControlBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nyforge.Radius.Pill}" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="FontSize" Value="{DynamicResource Nyforge.Type.Body}" />
  </Style>
  <Style Selector="Button.toolbar:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Nyforge.Brush.Hover}" />
  </Style>
  <Style Selector="Button.toolbar:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Nyforge.Brush.Pressed}" />
  </Style>

  <!-- ============================================================
       GHOST BUTTON — no border, pill-shaped
       ============================================================ -->
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nyforge.Radius.Pill}" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="FontSize" Value="{DynamicResource Nyforge.Type.Body}" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Nyforge.Brush.Hover}" />
  </Style>

  <!-- ============================================================
       DANGER BUTTON — red pill
       ============================================================ -->
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource Nyforge.Brush.Error}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nyforge.Radius.Pill}" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#FF6961" />
  </Style>

  <!-- ============================================================
       SEPARATOR — hairline divider
       ============================================================ -->
  <Style Selector="Border.separator">
    <Setter Property="Background" Value="{DynamicResource Nyforge.Brush.Separator}" />
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="0,4" />
  </Style>

  <!-- ============================================================
       STATUS BAR TEXT — small, muted
       ============================================================ -->
  <Style Selector="TextBlock.status-text">
    <Setter Property="FontSize" Value="{DynamicResource Nyforge.Type.Caption}" />
    <Setter Property="Foreground" Value="{DynamicResource Nyforge.Brush.TextSecondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ============================================================
       TOGGLE SWITCH — iOS-style
       ============================================================ -->
  <Style Selector="CheckBox.toggle">
    <Setter Property="FontSize" Value="{DynamicResource Nyforge.Type.Body}" />
  </Style>

  <!-- ============================================================
       TEXTBOX — refined with focus ring
       ============================================================ -->
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="{DynamicResource Nyforge.Radius.Small}" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="FontSize" Value="{DynamicResource Nyforge.Type.Body}" />
  </Style>

  <!-- ============================================================
       COMBOBOX — refined
       ============================================================ -->
  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="{DynamicResource Nyforge.Radius.Small}" />
    <Setter Property="FontSize" Value="{DynamicResource Nyforge.Type.Body}" />
    <Setter Property="MinHeight" Value="30" />
  </Style>

  <!-- ============================================================
       NUMERICUPDOWN — refined
       ============================================================ -->
  <Style Selector="NumericUpDown">
    <Setter Property="CornerRadius" Value="{DynamicResource Nyforge.Radius.Small}" />
    <Setter Property="FontSize" Value="{DynamicResource Nyforge.Type.Body}" />
    <Setter Property="MinHeight" Value="30" />
  </Style>

  <!-- ============================================================
       TREEVIEW — refined
       ============================================================ -->
  <Style Selector="TreeView">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontSize" Value="{DynamicResource Nyforge.Type.Body}" />
  </Style>

  <!-- ============================================================
       TABCONTROL — refined
       ============================================================ -->
  <Style Selector="TabControl">
    <Setter Property="Background" Value="{DynamicResource Nyforge.Brush.Surface}" />
  </Style>

  <!-- ============================================================
       PROGRESSBAR — iOS-style rounded
       ============================================================ -->
  <Style Selector="ProgressBar">
    <Setter Property="CornerRadius" Value="{DynamicResource Nyforge.Radius.Pill}" />
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="MaxHeight" Value="6" />
  </Style>

  <!-- ============================================================
       SLIDER — iOS-style
       ============================================================ -->
  <Style Selector="Slider">
    <Setter Property="MinHeight" Value="28" />
  </Style>

</Styles>
