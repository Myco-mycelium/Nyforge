<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="using:System">

  <!--
    Solar: Apple-inspired warm light theme for Nyforge.
    Same token keys as Eclipse.axaml — swapping changes appearance, never structure.
  -->
  <Styles.Resources>
    <ResourceDictionary>

      <!-- Surface hierarchy -->
      <Color x:Key="Nyforge.Color.Background">#F2F2F7</Color>
      <Color x:Key="Nyforge.Color.Surface">#FFFFFF</Color>
      <Color x:Key="Nyforge.Color.SurfaceElevated">#F9F9F9</Color>
      <Color x:Key="Nyforge.Color.SurfaceOverlay">#E5E5EA</Color>

      <!-- Separators -->
      <Color x:Key="Nyforge.Color.Separator">#D1D1D6</Color>

      <!-- Text hierarchy -->
      <Color x:Key="Nyforge.Color.TextPrimary">#1C1C1E</Color>
      <Color x:Key="Nyforge.Color.TextSecondary">#8E8E93</Color>
      <Color x:Key="Nyforge.Color.TextTertiary">#AEAEB2</Color>

      <!-- Accent: system blue -->
      <Color x:Key="Nyforge.Color.Accent">#007AFF</Color>
      <Color x:Key="Nyforge.Color.AccentStrong">#409CFF</Color>
      <Color x:Key="Nyforge.Color.AccentMuted">#E3F0FF</Color>

      <!-- Semantic status -->
      <Color x:Key="Nyforge.Color.Success">#34C759</Color>
      <Color x:Key="Nyforge.Color.Warning">#FF9500</Color>
      <Color x:Key="Nyforge.Color.Error">#FF3B30</Color>

      <!-- Borders -->
      <Color x:Key="Nyforge.Color.Border">#D1D1D6</Color>
      <Color x:Key="Nyforge.Color.ControlBorder">#C6C6C8</Color>

      <!-- Shadows -->
      <Color x:Key="Nyforge.Color.Shadow">#1A000000</Color>
      <Color x:Key="Nyforge.Color.ShadowElevated">#26000000</Color>

      <!-- Interaction states -->
      <Color x:Key="Nyforge.Color.Hover">#E5E5EA</Color>
      <Color x:Key="Nyforge.Color.Pressed">#D1D1D6</Color>
      <Color x:Key="Nyforge.Color.Selection">#007AFF22</Color>
      <Color x:Key="Nyforge.Color.FocusRing">#007AFF</Color>
      <Color x:Key="Nyforge.Color.ControlBorder">#C6C6C8</Color>
      <Color x:Key="Nyforge.Color.TextDisabled">#C7C7CC</Color>

      <!-- Spacing — 8pt grid -->
      <sys:Double x:Key="Nyforge.Space.1">4</sys:Double>
      <sys:Double x:Key="Nyforge.Space.2">8</sys:Double>
      <sys:Double x:Key="Nyforge.Space.3">12</sys:Double>
      <sys:Double x:Key="Nyforge.Space.4">16</sys:Double>
      <sys:Double x:Key="Nyforge.Space.5">24</sys:Double>
      <sys:Double x:Key="Nyforge.Space.6">32</sys:Double>
      <sys:Double x:Key="Nyforge.Space.7">48</sys:Double>
      <sys:Double x:Key="Nyforge.Space.8">64</sys:Double>

      <!-- Corner radius -->
      <CornerRadius x:Key="Nyforge.Radius.Small">6</CornerRadius>
      <CornerRadius x:Key="Nyforge.Radius.Medium">10</CornerRadius>
      <CornerRadius x:Key="Nyforge.Radius.Large">14</CornerRadius>
      <CornerRadius x:Key="Nyforge.Radius.Pill">9999</CornerRadius>

      <!-- Type scale -->
      <sys:Double x:Key="Nyforge.Type.Caption">11</sys:Double>
      <sys:Double x:Key="Nyforge.Type.Body">13</sys:Double>
      <sys:Double x:Key="Nyforge.Type.Callout">12</sys:Double>
      <sys:Double x:Key="Nyforge.Type.Subhead">14</sys:Double>
      <sys:Double x:Key="Nyforge.Type.Title">16</sys:Double>
      <sys:Double x:Key="Nyforge.Type.Headline">17</sys:Double>
      <sys:Double x:Key="Nyforge.Type.Display">22</sys:Double>

      <!-- Thickness tokens -->
      <Thickness x:Key="Nyforge.Inset.Small">4</Thickness>
      <Thickness x:Key="Nyforge.Inset.Medium">8</Thickness>
      <Thickness x:Key="Nyforge.Inset.Large">12</Thickness>

      <Thickness x:Key="Nyforge.Margin.Panel">12</Thickness>
      <Thickness x:Key="Nyforge.Margin.Canvas">16</Thickness>
      <Thickness x:Key="Nyforge.Margin.SectionHeader">16,16,16,6</Thickness>
      <Thickness x:Key="Nyforge.Margin.SectionTop">0,12,0,0</Thickness>
      <Thickness x:Key="Nyforge.Margin.SectionBottom">0,0,0,6</Thickness>
      <Thickness x:Key="Nyforge.Margin.PaletteItem">4,2</Thickness>
      <Thickness x:Key="Nyforge.Padding.PaletteItem">10,7</Thickness>
      <Thickness x:Key="Nyforge.Margin.StatusButton">8,4</Thickness>
      <Thickness x:Key="Nyforge.Margin.StatusButtonSide">0,4</Thickness>
      <Thickness x:Key="Nyforge.Margin.StatusText">0,0,12,0</Thickness>
      <Thickness x:Key="Nyforge.Margin.LabelRight">0,0,6,0</Thickness>
      <Thickness x:Key="Nyforge.Margin.BehaviorsLeft">0,0,12,0</Thickness>
      <Thickness x:Key="Nyforge.Margin.BehaviorCard">0,0,0,8</Thickness>
      <Thickness x:Key="Nyforge.Margin.ConditionState">0,0,8,0</Thickness>
      <Thickness x:Key="Nyforge.Padding.Card">10</Thickness>
      <Thickness x:Key="Nyforge.Padding.Banner">10,6</Thickness>
      <Thickness x:Key="Nyforge.Padding.LogBar">10</Thickness>

      <!-- Brushes -->
      <SolidColorBrush x:Key="Nyforge.Brush.Background" Color="{StaticResource Nyforge.Color.Background}" />
      <SolidColorBrush x:Key="Nyforge.Brush.Surface" Color="{StaticResource Nyforge.Color.Surface}" />
      <SolidColorBrush x:Key="Nyforge.Brush.SurfaceElevated" Color="{StaticResource Nyforge.Color.SurfaceElevated}" />
      <SolidColorBrush x:Key="Nyforge.Brush.SurfaceOverlay" Color="{StaticResource Nyforge.Color.SurfaceOverlay}" />
      <SolidColorBrush x:Key="Nyforge.Brush.Separator" Color="{StaticResource Nyforge.Color.Separator}" />
      <SolidColorBrush x:Key="Nyforge.Brush.TextPrimary" Color="{StaticResource Nyforge.Color.TextPrimary}" />
      <SolidColorBrush x:Key="Nyforge.Brush.TextSecondary" Color="{StaticResource Nyforge.Color.TextSecondary}" />
      <SolidColorBrush x:Key="Nyforge.Brush.TextTertiary" Color="{StaticResource Nyforge.Color.TextTertiary}" />
      <SolidColorBrush x:Key="Nyforge.Brush.Accent" Color="{StaticResource Nyforge.Color.Accent}" />
      <SolidColorBrush x:Key="Nyforge.Brush.AccentStrong" Color="{StaticResource Nyforge.Color.AccentStrong}" />
      <SolidColorBrush x:Key="Nyforge.Brush.AccentMuted" Color="{StaticResource Nyforge.Color.AccentMuted}" />
      <SolidColorBrush x:Key="Nyforge.Brush.Border" Color="{StaticResource Nyforge.Color.Border}" />
      <SolidColorBrush x:Key="Nyforge.Brush.ControlBorder" Color="{StaticResource Nyforge.Color.ControlBorder}" />
      <SolidColorBrush x:Key="Nyforge.Brush.Hover" Color="{StaticResource Nyforge.Color.Hover}" />
      <SolidColorBrush x:Key="Nyforge.Brush.Pressed" Color="{StaticResource Nyforge.Color.Pressed}" />
      <SolidColorBrush x:Key="Nyforge.Brush.Selection" Color="{StaticResource Nyforge.Color.Selection}" />
      <SolidColorBrush x:Key="Nyforge.Brush.FocusRing" Color="{StaticResource Nyforge.Color.FocusRing}" />
      <SolidColorBrush x:Key="Nyforge.Brush.TextDisabled" Color="{StaticResource Nyforge.Color.TextDisabled}" />
      <SolidColorBrush x:Key="Nyforge.Brush.Success" Color="{StaticResource Nyforge.Color.Success}" />
      <SolidColorBrush x:Key="Nyforge.Brush.Warning" Color="{StaticResource Nyforge.Color.Warning}" />
      <SolidColorBrush x:Key="Nyforge.Brush.Error" Color="{StaticResource Nyforge.Color.Error}" />
      <SolidColorBrush x:Key="Nyforge.Brush.Shadow" Color="{StaticResource Nyforge.Color.Shadow}" />
      <SolidColorBrush x:Key="Nyforge.Brush.ShadowElevated" Color="{StaticResource Nyforge.Color.ShadowElevated}" />

      <!-- Alias used by BehaviorsPanel -->
      <SolidColorBrush x:Key="Nyforge.Brush.BorderSubtle" Color="{StaticResource Nyforge.Color.Separator}" />

    </ResourceDictionary>
  </Styles.Resources>

</Styles>
