{
  "version": "1.0.0",
  "project": {
    "name": "Nyrqis Desktop Shell",
    "id": "nyrqis-desktop-shell",
    "created": "2026-08-20T00:00:00+00:00",
    "updated": "2026-08-20T00:00:00+00:00"
  },
  "themes": {
    "active": "Eclipse",
    "overrides": {}
  },
  "resources": {
    "images": [],
    "fonts": [],
    "icons": []
  },
  "states": {
    "startMenuOpen": false,
    "quickSettingsOpen": false,
    "notificationsOpen": false,
    "lockScreenOpen": false,
    "activeWindowId": null,
    "currentTime": "14:32",
    "batteryLevel": 87,
    "wifiConnected": true,
    "volumeLevel": 65,
    "doNotDisturb": false,
    "darkMode": true
  },
  "behaviors": [
    {
      "id": "b_start_toggle",
      "action": { "target": "start_menu", "name": "Toggle" }
    },
    {
      "id": "b_quicksettings_toggle",
      "action": { "target": "quick_settings", "name": "Toggle" }
    },
    {
      "id": "b_notifications_toggle",
      "action": { "target": "notification_center", "name": "Toggle" }
    },
    {
      "id": "b_lock_screen",
      "action": { "target": "lock_screen", "name": "Open" }
    },
    {
      "id": "b_open_settings",
      "action": { "target": "System", "name": "Nyrqis.Launch", "arguments": { "app": "settings" } }
    },
    {
      "id": "b_open_files",
      "action": { "target": "System", "name": "Nyrqis.Launch", "arguments": { "app": "files" } }
    },
    {
      "id": "b_open_terminal",
      "action": { "target": "System", "name": "Nyrqis.Launch", "arguments": { "app": "terminal" } }
    },
    {
      "id": "b_power_off",
      "action": { "target": "System", "name": "Nyrqis.Power.Off" }
    },
    {
      "id": "b_power_restart",
      "action": { "target": "System", "name": "Nyrqis.Power.Restart" }
    },
    {
      "id": "b_workspace_left",
      "action": { "target": "workspace_switcher", "name": "SetCurrentWorkspace", "arguments": { "index": 0 } }
    },
    {
      "id": "b_workspace_right",
      "action": { "target": "workspace_switcher", "name": "SetCurrentWorkspace", "arguments": { "index": 2 } }
    }
  ],
  "bindings": [
    { "component": "start_menu", "property": "open", "state": "startMenuOpen" },
    { "component": "quick_settings", "property": "open", "state": "quickSettingsOpen" },
    { "component": "notification_center", "property": "open", "state": "notificationsOpen" },
    { "component": "lock_screen", "property": "open", "state": "lockScreenOpen" },
    { "component": "clock_display", "property": "text", "state": "currentTime" }
  ],
  "components": [],
  "animations": [
    {
      "id": "anim_start_open",
      "target": "start_menu",
      "property": "y",
      "from": 100,
      "to": 0,
      "duration": 200,
      "easing": "ease-out"
    },
    {
      "id": "anim_start_close",
      "target": "start_menu",
      "property": "y",
      "from": 0,
      "to": 100,
      "duration": 150,
      "easing": "ease-in"
    },
    {
      "id": "anim_notification_slide",
      "target": "notification_center",
      "property": "x",
      "from": 400,
      "to": 0,
      "duration": 250,
      "easing": "ease-out"
    }
  ],
  "screens": [
    {
